<?xml version="1.0"?>
<package format="3">
  <name>isaac_policy_stack</name>
  <version>0.1.0</version>
  <description>Meta-package that groups Isaac policy runtime, bringup, and tools in a single repository.</description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>BSD-3-Clause</license>

  <!-- Meta-package: no build artifacts -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Pull in the actual packages -->
  <exec_depend>isaac_policy_runtime</exec_depend>
  <exec_depend>isaac_policy_bringup</exec_depend>

  <!-- Optional: if you add a bundles package later -->
  <!-- <exec_depend>isaac_policy_bundles</exec_depend> -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
